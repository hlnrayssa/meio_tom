using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class ItemColetavel : MonoBehaviour
{
    public ItemSO dados; // arraste o Scriptable Object do item aqui

    // Start is called before the first frame update
    void Start()
    {
        // ativa a cor do item assim que o jogo começa
        GetComponent<Renderer>().material.color = dados.cor;
    }

    void OnTriggerEnter(Collider other)
    {
        if (other.CompareTag("Player"))
        {
            GameManager.instance.ColetarItem(dados.pontos);
            Destroy(gameObject);
        }
    }
}